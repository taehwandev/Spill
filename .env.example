# Copy this file to .env.local and fill the values from your deployment dashboard.

# Shared analytics key. The app, landing page, and installer use this when a
# more specific key is not set.
SPILL_APTABASE_APP_KEY=

# Landing page analytics key used by scripts/prepare-docs.sh.
SPILL_WEB_APTABASE_APP_KEY=

# Installer analytics key used by scripts/prepare-docs.sh for docs/install.sh.
SPILL_INSTALLER_APTABASE_APP_KEY=
