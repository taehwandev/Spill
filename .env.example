# Copy this file to .env.local and fill the values from your deployment dashboard.

# Shared analytics key. The app, landing page, and installer use this when a
# more specific key is not set.
SPILL_APTABASE_APP_KEY=

# Landing page analytics key used by scripts/prepare-docs.sh.
SPILL_WEB_APTABASE_APP_KEY=

# Installer analytics key used by scripts/prepare-docs.sh for docs/install.sh.
SPILL_INSTALLER_APTABASE_APP_KEY=

# Optional local release metadata.
# SPILL_VERSION defaults to the current UTC ISO year/week plus release count 1.
# SPILL_BUILD defaults to the final component of SPILL_VERSION.
SPILL_VERSION=
SPILL_BUILD=
SPILL_BUNDLE_ID=dev.spill.Spill

# Optional local Developer ID signing and notarization.
# Create the profile with:
# xcrun notarytool store-credentials spill-notary --apple-id <apple-id> --team-id <team-id> --password <app-specific-password>
SPILL_SIGN_IDENTITY=
SPILL_NOTARY_KEYCHAIN_PROFILE=
