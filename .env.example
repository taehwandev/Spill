# Copy this file to .env.local for local development.

# Shared analytics key. The app, landing page, and installer use this when a
# more specific key is not set.
SPILL_APTABASE_APP_KEY=

# Optional crash and hang diagnostics for local bundles. Sentry remains disabled
# when this DSN is empty. Keep prompts, token payloads, local paths, and logs out
# of Sentry events.
SPILL_SENTRY_DSN=
SPILL_SENTRY_ENVIRONMENT=development
SPILL_SENTRY_RELEASE=
SPILL_SENTRY_DIST=
SPILL_GIT_COMMIT_SHA=

# Landing page analytics key used by scripts/prepare-docs.sh.
SPILL_WEB_APTABASE_APP_KEY=

# Installer analytics key used by scripts/prepare-docs.sh for docs/install.sh.
SPILL_INSTALLER_APTABASE_APP_KEY=

# Optional local release metadata.
# SPILL_VERSION defaults to the current UTC ISO year/week plus release count 1.
# SPILL_BUILD defaults to the full SPILL_VERSION string (e.g. 2026.25.1).
SPILL_VERSION=
SPILL_BUILD=
SPILL_BUNDLE_ID=dev.spill.Spill

# Optional private usage upload build-time configuration for scripts/build-app.sh.
# Leave this flag at 0 when the app should hide Private Usage Upload login/sync
# UI and disable upload handlers. Set it to 1 only for bundles that must expose
# Sign In/Connect and validate web and relay URLs.
SPILL_BUILD_PRIVATE_USAGE_FEATURE_ENABLED=0
SPILL_BUILD_PRIVATE_USAGE_ENVIRONMENT=
SPILL_BUILD_PRIVATE_USAGE_RELAY_URL=
SPILL_BUILD_PRIVATE_USAGE_WEB_URL=

# Optional private usage upload runtime overrides for local terminal debugging only.
# GUI-launched apps usually do not inherit shell env; release artifacts read the
# Info.plist values written from SPILL_BUILD_PRIVATE_USAGE_* instead.
SPILL_PRIVATE_USAGE_FEATURE_ENABLED=
SPILL_PRIVATE_USAGE_ENVIRONMENT=
SPILL_PRIVATE_USAGE_RELAY_URL=
SPILL_PRIVATE_USAGE_WEB_URL=

# Optional local Developer ID signing.
SPILL_SIGN_IDENTITY=
SPILL_INSTALLER_SIGN_IDENTITY=

# Optional local App Store Connect API-key notarization.
# Use a repository secret for APPLE_NOTARYTOOL_API_KEY in GitHub Actions. For
# local release tests, APPLE_NOTARYTOOL_API_KEY_PATH may point at an ignored .p8
# file instead of placing the private key content in the shell environment.
APPLE_NOTARYTOOL_API_KEY=
APPLE_NOTARYTOOL_API_KEY_PATH=
APPLE_NOTARYTOOL_API_KEY_ID=
APPLE_NOTARYTOOL_API_ISSUER=
APPLE_NOTARYTOOL_TIMEOUT=45m
