    "token_metering.format.percent_of_total": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld%% of total"}},"ja":{"stringUnit":{"state":"translated","value":"全体の%lld%%"}},"ko":{"stringUnit":{"state":"translated","value":"전체의 %lld%%"}}}},
    "token_metering.format.percent_string_of_total": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of total"}},"ja":{"stringUnit":{"state":"translated","value":"全体の%@"}},"ko":{"stringUnit":{"state":"translated","value":"전체의 %@"}}}},
