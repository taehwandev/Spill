    "token_metering.privateUsageUploadOpenWeb": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign In and Connect"}},"ja":{"stringUnit":{"state":"translated","value":"ログインして接続"}},"ko":{"stringUnit":{"state":"translated","value":"로그인하고 연결"}}}},
    "token_metering.privateUsageUploadOpenWebDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens Spill web for account sign-in, then returns a short-lived device link to this Mac."}},"ja":{"stringUnit":{"state":"translated","value":"Spill Web でアカウントにログインし、短時間のデバイスリンクをこの Mac に返します。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill 웹에서 계정에 로그인한 뒤 짧게 유효한 기기 링크를 이 Mac으로 돌려보냅니다."}}}},
    "token_metering.privateUsageUploadQueued": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Queued"}},"ja":{"stringUnit":{"state":"translated","value":"待機中"}},"ko":{"stringUnit":{"state":"translated","value":"대기 중"}}}},
    "token_metering.privateUsageUploadRelayURLUnavailableMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Upload service URL is unavailable."}},"ja":{"stringUnit":{"state":"translated","value":"アップロードサービスの URL を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"업로드 서비스 주소를 사용할 수 없습니다."}}}},
    "token_metering.privateUsageUploadRelayUnavailableMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Upload service is unavailable. Spill will retry automatically."}},"ja":{"stringUnit":{"state":"translated","value":"アップロードサービスを利用できません。Spill が自動的に再試行します。"}},"ko":{"stringUnit":{"state":"translated","value":"업로드 서비스를 사용할 수 없습니다. Spill이 자동으로 다시 시도합니다."}}}},
    "token_metering.privateUsageUploadStateConnected": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected"}},"ja":{"stringUnit":{"state":"translated","value":"接続済み"}},"ko":{"stringUnit":{"state":"translated","value":"연결됨"}}}},
    "token_metering.privateUsageUploadStateEnabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabled"}},"ja":{"stringUnit":{"state":"translated","value":"有効"}},"ko":{"stringUnit":{"state":"translated","value":"활성"}}}},
    "token_metering.privateUsageUploadStateOptional": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional"}},"ja":{"stringUnit":{"state":"translated","value":"任意"}},"ko":{"stringUnit":{"state":"translated","value":"선택 사항"}}}},
    "token_metering.privateUsageUploadSyncNow": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync Now"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ同期"}},"ko":{"stringUnit":{"state":"translated","value":"지금 동기화"}}}},
    "token_metering.privateUsageUploadSyncing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syncing"}},"ja":{"stringUnit":{"state":"translated","value":"同期中"}},"ko":{"stringUnit":{"state":"translated","value":"동기화 중"}}}},
    "token_metering.privateUsageUploadTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private Usage Upload"}},"ja":{"stringUnit":{"state":"translated","value":"プライベート使用量アップロード"}},"ko":{"stringUnit":{"state":"translated","value":"비공개 사용량 업로드"}}}},
    "token_metering.privateUsageUploadToggleDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local metering keeps working when this is off."}},"ja":{"stringUnit":{"state":"translated","value":"オフにしてもローカル計測は動作します。"}},"ko":{"stringUnit":{"state":"translated","value":"꺼져 있어도 로컬 미터링은 계속 동작합니다."}}}},
    "token_metering.privateUsageUploadToggleTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Upload encrypted daily totals"}},"ja":{"stringUnit":{"state":"translated","value":"暗号化した日別合計をアップロード"}},"ko":{"stringUnit":{"state":"translated","value":"암호화된 일별 합계 업로드"}}}},
    "token_metering.privateUsageUploadUnavailableMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private Usage Upload is unavailable."}},"ja":{"stringUnit":{"state":"translated","value":"プライベート使用量アップロードを利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"비공개 사용량 업로드를 사용할 수 없습니다."}}}},
    "token_metering.privateUsageUploadUploadedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Encrypted daily totals uploaded."}},"ja":{"stringUnit":{"state":"translated","value":"暗号化した日別合計をアップロードしました。"}},"ko":{"stringUnit":{"state":"translated","value":"암호화된 일별 합계를 업로드했습니다."}}}},
    "token_metering.promptDisplayNamesDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off keeps copied prompts token-only. On adds an opt-in block that permits user-provided or trusted workflow display aliases only; commands and prompt content remain forbidden."}},"ja":{"stringUnit":{"state":"translated","value":"オフではコピーしたプロンプトをトークン専用ポリシーのままにします。オンでは、ユーザー指定または信頼済みワークフローの表示エイリアスだけを許可する opt-in ブロックを追加します。コマンドとプロンプト内容は引き続き禁止です。"}},"ko":{"stringUnit":{"state":"translated","value":"꺼두면 복사된 프롬프트가 토큰 전용 정책을 유지합니다. 켜면 사용자가 지정했거나 신뢰된 워크플로우 표시 별칭만 허용하는 opt-in 블록을 추가합니다. 명령어와 프롬프트 내용은 계속 금지됩니다."}}}},
    "token_metering.promptDisplayNamesDisabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Strict"}},"ja":{"stringUnit":{"state":"translated","value":"厳格"}},"ko":{"stringUnit":{"state":"translated","value":"엄격"}}}},
    "token_metering.promptDisplayNamesEnabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabled"}},"ja":{"stringUnit":{"state":"translated","value":"有効"}},"ko":{"stringUnit":{"state":"translated","value":"켜짐"}}}},
    "token_metering.promptDisplayNamesReapplyWarning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy and reapply the install prompt now. Existing agent instructions will not change until the new prompt is applied, and local display names may be visible to the agent."}},"ja":{"stringUnit":{"state":"translated","value":"今すぐインストールプロンプトをコピーして再適用してください。新しいプロンプトを適用するまで既存のエージェント指示は変わらず、ローカル表示名がエージェントに見える場合があります。"}},"ko":{"stringUnit":{"state":"translated","value":"지금 설치 프롬프트를 복사해서 다시 적용해야 합니다. 새 프롬프트를 적용하기 전까지 기존 에이전트 지침은 바뀌지 않으며, 로컬 표시명이 에이전트에 보일 수 있습니다."}}}},
    "token_metering.promptDisplayNamesTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow local display names in copied prompt"}},"ja":{"stringUnit":{"state":"translated","value":"コピーしたプロンプトでローカル表示名を許可"}},"ko":{"stringUnit":{"state":"translated","value":"복사한 프롬프트에서 로컬 표시명 허용"}}}},
    "token_metering.queueSelfTestFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local queue self-test failed."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルキュー self-test に失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 큐 self-test에 실패했습니다."}}}},
    "token_metering.queueSelfTestSuccess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local queue accepted and stored a categorized 64-token self-test event."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルキューが分類済み 64 トークンの self-test イベントを保存しました。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 큐가 분류된 64토큰 self-test 이벤트를 저장했습니다."}}}},
    "token_metering.queueSelfTestWriteFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not write to the local token metering queue."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルトークン計測キューへ書き込めません。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 토큰 미터링 큐에 쓸 수 없습니다."}}}},
    "token_metering.queueTest": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save Test"}},"ja":{"stringUnit":{"state":"translated","value":"保存テスト"}},"ko":{"stringUnit":{"state":"translated","value":"저장 테스트"}}}},
    "token_metering.receivers": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recording"}},"ja":{"stringUnit":{"state":"translated","value":"記録方法"}},"ko":{"stringUnit":{"state":"translated","value":"기록 방식"}}}},
    "token_metering.recentMonth": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent Month"}},"ja":{"stringUnit":{"state":"translated","value":"直近1か月"}},"ko":{"stringUnit":{"state":"translated","value":"최근 1개월"}}}},
    "token_metering.recommended": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommended"}},"ja":{"stringUnit":{"state":"translated","value":"推奨"}},"ko":{"stringUnit":{"state":"translated","value":"권장"}}}},
    "token_metering.reviewLocalDataDelete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Delete"}},"ja":{"stringUnit":{"state":"translated","value":"削除内容を確認"}},"ko":{"stringUnit":{"state":"translated","value":"삭제 전 확인"}}}},
    "token_metering.refresh": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh"}},"ja":{"stringUnit":{"state":"translated","value":"更新"}},"ko":{"stringUnit":{"state":"translated","value":"새로고침"}}}},
    "token_metering.relativePreviousMonth": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"prev month"}},"ja":{"stringUnit":{"state":"translated","value":"前月"}},"ko":{"stringUnit":{"state":"translated","value":"전달"}}}},
    "token_metering.relativePreviousWeek": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"prev week"}},"ja":{"stringUnit":{"state":"translated","value":"前週"}},"ko":{"stringUnit":{"state":"translated","value":"전주"}}}},
    "token_metering.relativeYesterday": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"yesterday"}},"ja":{"stringUnit":{"state":"translated","value":"昨日"}},"ko":{"stringUnit":{"state":"translated","value":"어제"}}}},
    "token_metering.run": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work Item"}},"ja":{"stringUnit":{"state":"translated","value":"作業項目"}},"ko":{"stringUnit":{"state":"translated","value":"작업 항목"}}}},
    "token_metering.runs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work Items"}},"ja":{"stringUnit":{"state":"translated","value":"作業単位"}},"ko":{"stringUnit":{"state":"translated","value":"작업 단위"}}}},
    "token_metering.runsInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work items are grouped from opaque folder ids, safe categories, and dates. Folder labels use short ids only; internal identifiers stay in diagnostics."}},"ja":{"stringUnit":{"state":"translated","value":"作業は不透明なフォルダ ID、安全な分類、日付でグループ化します。フォルダ表示は短い ID のみを使い、内部識別子は診断に残します。"}},"ko":{"stringUnit":{"state":"translated","value":"작업은 불투명한 폴더 ID, 안전한 분류값, 날짜 기준으로 묶습니다. 폴더 표시는 짧은 ID만 쓰고 내부 식별자는 진단 영역에 둡니다."}}}},
    "token_metering.runsInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work items"}},"ja":{"stringUnit":{"state":"translated","value":"作業集計"}},"ko":{"stringUnit":{"state":"translated","value":"작업 집계"}}}},
    "token_metering.runsSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grouped by folder, work type, and date"}},"ja":{"stringUnit":{"state":"translated","value":"フォルダ、作業タイプ、日付ごとのグループ"}},"ko":{"stringUnit":{"state":"translated","value":"폴더, 작업 유형, 날짜별 묶음"}}}},
    "token_metering.runtimeTimingUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No timing information"}},"ja":{"stringUnit":{"state":"translated","value":"時間情報なし"}},"ko":{"stringUnit":{"state":"translated","value":"시간 정보 없음"}}}},
    "token_metering.saveTestFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not save the local test event."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルテストイベントを保存できません。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 테스트 이벤트를 저장할 수 없습니다."}}}},
    "token_metering.selectedRun": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected Work Item"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の作業"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 작업"}}}},
    "token_metering.selectedWorkItem": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected work item"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の作業"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 작업"}}}},
    "token_metering.selectedWorkItemHeader": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SELECTED WORK ITEM"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の作業"}},"ko":{"stringUnit":{"state":"translated","value":"선택된 작업"}}}},
    "token_metering.setupApplyWhereDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start with the global prompt. When the installer asks about workflow-aware labels, choose yes only if you use a workflow runner or agent lifecycle script; the agent should discover and ask before editing that workflow."}},"ja":{"stringUnit":{"state":"translated","value":"まずグローバルプロンプトを適用してください。インストール中に workflow-aware labels を聞かれたら、ワークフロー runner や agent lifecycle script を使う場合だけ yes を選びます。エージェントは候補を探し、編集前に確認する必要があります。"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 전역 프롬프트를 적용하세요. 설치 중 workflow-aware labels를 물으면 워크플로우 러너나 agent lifecycle 스크립트를 쓰는 경우에만 yes를 선택하세요. 에이전트는 후보를 직접 찾고 수정 전 확인해야 합니다."}}}},
    "token_metering.setupApplyWhereTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Where to connect it"}},"ja":{"stringUnit":{"state":"translated","value":"接続先"}},"ko":{"stringUnit":{"state":"translated","value":"어디에 연결해야 하나요"}}}},
    "token_metering.setupGlobalInstructionDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the copied prompt in the agent's global or user-level instruction area. It is not project-specific; every repo on this Mac can report into the same local Spill meter."}},"ja":{"stringUnit":{"state":"translated","value":"コピーしたプロンプトはエージェントの global または user-level instruction に入れます。プロジェクト専用ではなく、この Mac の各 repo から同じローカル Spill メーターへ記録できます。"}},"ko":{"stringUnit":{"state":"translated","value":"복사한 프롬프트는 에이전트의 global 또는 user-level instruction 영역에 넣는 용도입니다. 프로젝트별 설정이 아니며, 이 Mac의 모든 repo가 같은 로컬 Spill meter로 기록될 수 있습니다."}}}},
    "token_metering.setupGlobalInstructionTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apply it globally first"}},"ja":{"stringUnit":{"state":"translated","value":"まずグローバル指示へ適用"}},"ko":{"stringUnit":{"state":"translated","value":"먼저 전역 지침에 적용"}}}},
    "token_metering.setupWorkflowLabelsDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Base connections still give useful total, input, and output counts. A trusted workflow adds more reliable labels for review, coding, tests, commits, docs, and setup."}},"ja":{"stringUnit":{"state":"translated","value":"基本接続だけでも合計、入力、出力の数値は有用です。信頼済みの作業フローを接続すると、レビュー、実装、テスト、コミット、ドキュメント、設定作業をより確実に分離できます。"}},"ko":{"stringUnit":{"state":"translated","value":"기본 연결만으로도 합계, 입력, 출력 수치는 유용합니다. 신뢰된 작업 흐름을 연결하면 리뷰, 코드 작성, 테스트, 커밋, 문서, 설정 작업을 더 안정적으로 분리할 수 있습니다."}}}},
    "token_metering.setupWorkflowLabelsTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Workflow labels are more accurate"}},"ja":{"stringUnit":{"state":"translated","value":"ワークフローラベルの方が正確"}},"ko":{"stringUnit":{"state":"translated","value":"워크플로우 라벨이 더 정확합니다"}}}},
    "token_metering.sourceBreakdown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime Detail"}},"ja":{"stringUnit":{"state":"translated","value":"実行時詳細"}},"ko":{"stringUnit":{"state":"translated","value":"런타임 세부"}}}},
    "token_metering.sourceBreakdownSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact categories when reported"}},"ja":{"stringUnit":{"state":"translated","value":"報告された正確なカテゴリのみ"}},"ko":{"stringUnit":{"state":"translated","value":"정확히 보고된 카테고리만"}}}},
    "token_metering.sourceGeneratedOutput": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI response"}},"ja":{"stringUnit":{"state":"translated","value":"AI の応答"}},"ko":{"stringUnit":{"state":"translated","value":"AI 응답"}}}},
    "token_metering.sourceHistory": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conversation history"}},"ja":{"stringUnit":{"state":"translated","value":"会話履歴"}},"ko":{"stringUnit":{"state":"translated","value":"대화 기록"}}}},
    "token_metering.sourceInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Input and output totals are the reliable baseline. This chart splits tokens only when the AI tool reports exact category counts. Unknown means detail attribution was unavailable; Spill does not read prompts, files, logs, or code to guess."}},"ja":{"stringUnit":{"state":"translated","value":"入力と出力の合計が信頼できる基準です。この表示は AI ツールが項目別のトークン数を正確に報告した場合だけ分けます。不明は詳細の割り当てが利用できないという意味で、Spill はプロンプト、ファイル、ログ、コードを読んで推測しません。"}},"ko":{"stringUnit":{"state":"translated","value":"입력과 출력 합계가 신뢰할 수 있는 기준입니다. 이 차트는 AI 도구가 항목별 토큰 수를 정확히 알려줄 때만 나눕니다. 미분류는 세부 귀속을 알 수 없다는 뜻이며, Spill은 프롬프트, 파일, 로그, 코드를 읽어 추정하지 않습니다."}}}},
