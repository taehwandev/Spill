    "token_metering.noStageSplit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No work step data"}},"ja":{"stringUnit":{"state":"translated","value":"作業ステップなし"}},"ko":{"stringUnit":{"state":"translated","value":"작업 단계 없음"}}}},
