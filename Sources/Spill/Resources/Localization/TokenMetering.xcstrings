    "token_metering.privacyBoundaryDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No prompts, commands, files, logs, changes, code content, environment values, or secrets."}},"ja":{"stringUnit":{"state":"translated","value":"プロンプト、コマンド、ファイル、ログ、変更内容、コード内容、環境値、シークレットは保存しません。"}},"ko":{"stringUnit":{"state":"translated","value":"프롬프트, 명령, 파일, 로그, 변경 내역, 코드 내용, 환경 값, 비밀은 저장하지 않습니다."}}}},
    "token_metering.privateUsageUploadConnectedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Mac is connected. Daily encrypted upload is enabled."}},"ja":{"stringUnit":{"state":"translated","value":"この Mac は接続済みです。暗号化した日別アップロードが有効になりました。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac이 연결되었습니다. 암호화된 일별 업로드가 활성화되었습니다."}}}},
    "token_metering.privateUsageUploadConnectionExpiredMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection expired or revoked. Reconnect this Mac."}},"ja":{"stringUnit":{"state":"translated","value":"接続の期限切れ、または取り消し済みです。この Mac を再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결이 만료되었거나 해제되었습니다. 이 Mac을 다시 연결하세요."}}}},
    "token_metering.privateUsageUploadConnectionRequiredMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection required. Reconnect this Mac."}},"ja":{"stringUnit":{"state":"translated","value":"接続が必要です。この Mac を再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"연결이 필요합니다. 이 Mac을 다시 연결하세요."}}}},
    "token_metering.privateUsageUploadDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect from Spill web with a short-lived code. This Mac stores only a write-only upload credential and sends encrypted daily totals through Spill."}},"ja":{"stringUnit":{"state":"translated","value":"Spill Web の短時間コードで接続します。この Mac はアップロード専用の認証情報だけを保存し、暗号化した日別合計だけを Spill に送信します。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill 웹에서 짧은 연결 코드로 연결합니다. 이 Mac은 업로드 전용 인증 정보만 저장하고 암호화된 일별 합계만 Spill로 보냅니다."}}}},
    "token_metering.privateUsageUploadDisabledMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private Usage Upload is disabled."}},"ja":{"stringUnit":{"state":"translated","value":"プライベート使用量アップロードはオフです。"}},"ko":{"stringUnit":{"state":"translated","value":"비공개 사용량 업로드가 꺼져 있습니다."}}}},
    "token_metering.privateUsageUploadDisconnect": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disconnect"}},"ja":{"stringUnit":{"state":"translated","value":"切断"}},"ko":{"stringUnit":{"state":"translated","value":"연결 해제"}}}},
    "token_metering.privateUsageUploadDisconnectedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Mac is disconnected."}},"ja":{"stringUnit":{"state":"translated","value":"この Mac の接続を解除しました。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac의 연결이 해제되었습니다."}}}},
    "token_metering.privateUsageUploadEncryptionFailedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Encrypted daily totals could not be prepared."}},"ja":{"stringUnit":{"state":"translated","value":"暗号化した日別合計を準備できません。"}},"ko":{"stringUnit":{"state":"translated","value":"암호화된 일별 합계를 준비할 수 없습니다."}}}},
    "token_metering.privateUsageUploadEnvironment": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Environment"}},"ja":{"stringUnit":{"state":"translated","value":"環境"}},"ko":{"stringUnit":{"state":"translated","value":"환경"}}}},
    "token_metering.privateUsageUploadEnvironmentDevelopment": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Development"}},"ja":{"stringUnit":{"state":"translated","value":"開発"}},"ko":{"stringUnit":{"state":"translated","value":"개발"}}}},
    "token_metering.privateUsageUploadEnvironmentDevelopmentDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the local development upload service and separate development credentials."}},"ja":{"stringUnit":{"state":"translated","value":"ローカル開発用のアップロードサービスを使い、開発用の認証情報を分けて保存します。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 개발 업로드 서비스를 사용하고 개발용 인증 정보를 따로 보관합니다."}}}},
    "token_metering.privateUsageUploadEnvironmentProduction": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Production"}},"ja":{"stringUnit":{"state":"translated","value":"本番"}},"ko":{"stringUnit":{"state":"translated","value":"운영"}}}},
    "token_metering.privateUsageUploadEnvironmentProductionDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the live Spill upload service and separate production credentials."}},"ja":{"stringUnit":{"state":"translated","value":"本番の Spill アップロードサービスを使い、本番用の認証情報を分けて保存します。"}},"ko":{"stringUnit":{"state":"translated","value":"운영 Spill 업로드 서비스를 사용하고 운영용 인증 정보를 따로 보관합니다."}}}},
    "token_metering.privateUsageUploadInvalidConnectionCodeMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a current connection code from Spill web."}},"ja":{"stringUnit":{"state":"translated","value":"Spill Web の新しい接続コードを使ってください。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill 웹에서 새 연결 코드를 받아 사용하세요."}}}},
    "token_metering.privateUsageUploadInvalidGrantCodeMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid connection code from Spill web."}},"ja":{"stringUnit":{"state":"translated","value":"Spill Web の有効な接続コードを入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill 웹의 올바른 연결 코드를 입력하세요."}}}},
    "token_metering.privateUsageUploadInvalidRelayResponseMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Upload service returned an invalid response."}},"ja":{"stringUnit":{"state":"translated","value":"アップロードサービスから無効な応答が返されました。"}},"ko":{"stringUnit":{"state":"translated","value":"업로드 서비스가 올바르지 않은 응답을 보냈습니다."}}}},
    "token_metering.privateUsageUploadKeyWrappingFailedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Encrypted upload key could not be prepared."}},"ja":{"stringUnit":{"state":"translated","value":"暗号化したアップロードキーを準備できません。"}},"ko":{"stringUnit":{"state":"translated","value":"암호화된 업로드 키를 준비할 수 없습니다."}}}},
    "token_metering.privateUsageUploadKeychainReadFailedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved connection could not be read."}},"ja":{"stringUnit":{"state":"translated","value":"保存済みの接続情報を読み取れません。"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 연결 정보를 읽을 수 없습니다."}}}},
    "token_metering.privateUsageUploadKeychainWriteFailedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved connection could not be updated."}},"ja":{"stringUnit":{"state":"translated","value":"保存済みの接続情報を更新できません。"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 연결 정보를 업데이트할 수 없습니다."}}}},
    "token_metering.privateUsageUploadLastBackup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last backup"}},"ja":{"stringUnit":{"state":"translated","value":"前回のバックアップ"}},"ko":{"stringUnit":{"state":"translated","value":"최근 백업"}}}},
    "token_metering.privateUsageUploadMissingCredentialMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect this Mac before syncing."}},"ja":{"stringUnit":{"state":"translated","value":"同期する前にこの Mac を接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"동기화하기 전에 이 Mac을 연결하세요."}}}},
    "token_metering.privateUsageUploadMissingKeyWrappingSecretMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reconnect this Mac with a current Spill web code."}},"ja":{"stringUnit":{"state":"translated","value":"Spill Web の新しいコードでこの Mac を再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill 웹의 새 코드로 이 Mac을 다시 연결하세요."}}}},
    "token_metering.privateUsageUploadMissingSealingKeyMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved upload key is unavailable. Reconnect this Mac."}},"ja":{"stringUnit":{"state":"translated","value":"保存済みのアップロードキーを利用できません。この Mac を再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 업로드 키를 사용할 수 없습니다. 이 Mac을 다시 연결하세요."}}}},
    "token_metering.privateUsageUploadNextAuto": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Next auto"}},"ja":{"stringUnit":{"state":"translated","value":"次回の自動実行"}},"ko":{"stringUnit":{"state":"translated","value":"다음 자동 실행"}}}},
    "token_metering.privateUsageUploadNoQueuedMessage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No daily totals are queued."}},"ja":{"stringUnit":{"state":"translated","value":"待機中の日別合計はありません。"}},"ko":{"stringUnit":{"state":"translated","value":"대기 중인 일별 합계가 없습니다."}}}},
