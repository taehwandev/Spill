    "token_metering.noRunSelectedDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records appear here after an AI tool reports exact token counts."}},"ja":{"stringUnit":{"state":"translated","value":"AI ツールが正確なトークン数を記録するとここに表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구가 정확한 토큰 수를 기록하면 여기에 표시됩니다."}}}},
