    "token_metering.format.spans_detail_with_latency": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ records / %@ / %@"}},"ja":{"stringUnit":{"state":"translated","value":"記録 %@件 / %@ / %@"}},"ko":{"stringUnit":{"state":"translated","value":"기록 %@개 / %@ / %@"}}}},
    "token_metering.hookConfig": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection config"}},"ja":{"stringUnit":{"state":"translated","value":"接続設定"}},"ko":{"stringUnit":{"state":"translated","value":"연결 설정"}}}},
    "token_metering.historyImportAllStart": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import All Once"}},"ja":{"stringUnit":{"state":"translated","value":"すべてを一度だけ取り込む"}},"ko":{"stringUnit":{"state":"translated","value":"전체 한 번 가져오기"}}}},
    "token_metering.historyImportCancel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel"}},"ja":{"stringUnit":{"state":"translated","value":"キャンセル"}},"ko":{"stringUnit":{"state":"translated","value":"취소"}}}},
    "token_metering.historyImportDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step 2 after setup: import existing local Codex, Claude Code, and Antigravity/AGY history from this Mac. Spill reads known local JSONL, transcript, and metadata stores only to extract exact token counts, timestamps, model ids, and opaque ids. Existing rows and labels are preserved, and duplicates are skipped."}},"ja":{"stringUnit":{"state":"translated","value":"セットアップ後のステップ 2: この Mac にある Codex、Claude Code、Antigravity/AGY の既存ローカル履歴を取り込みます。Spill は既知のローカル JSONL、会話記録、メタデータストアを、正確なトークン数、時刻、モデル ID、不透明 ID の抽出にのみ読みます。既存の行とラベルは保持され、重複はスキップされます。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 후 2단계: 이 Mac에 이미 남아 있는 Codex, Claude Code, Antigravity/AGY 로컬 기록을 가져옵니다. Spill은 알려진 로컬 JSONL, 대화 기록, 메타데이터 저장소에서 정확한 토큰 수, 시간, 모델 ID, 불투명 ID만 추출합니다. 기존 행과 라벨은 보존하고 중복은 건너뜁니다."}}}},
    "token_metering.historyImportExperimental": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Experimental"}},"ja":{"stringUnit":{"state":"translated","value":"実験的"}},"ko":{"stringUnit":{"state":"translated","value":"실험적"}}}},
    "token_metering.historyImportFullScanWarning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommendation: run the all-tool import once right after installing Spill if you want older local history. Later, use per-tool import for repair. Old rows without timeline evidence use safe fallback labels."}},"ja":{"stringUnit":{"state":"translated","value":"推奨: 古いローカル履歴を取り込みたい場合は、Spill のインストール直後に全ツール取り込みを一度だけ実行してください。以後の修復にはツール別取り込みを使います。タイムライン根拠のない古い行は安全なフォールバックラベルになります。"}},"ko":{"stringUnit":{"state":"translated","value":"권장: 예전 로컬 기록을 가져오고 싶다면 Spill 설치 직후 전체 가져오기를 한 번만 실행하세요. 이후 보정은 도구별 가져오기를 사용합니다. 타임라인 근거가 없는 오래된 행은 안전 기본 라벨로 들어갑니다."}}}},
    "token_metering.historyImportFirstMode": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Full history"}},"ja":{"stringUnit":{"state":"translated","value":"全履歴"}},"ko":{"stringUnit":{"state":"translated","value":"전체 기록"}}}},
    "token_metering.historyImportIncrementalMode": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent import"}},"ja":{"stringUnit":{"state":"translated","value":"直近の取り込み"}},"ko":{"stringUnit":{"state":"translated","value":"최근 가져오기"}}}},
    "token_metering.historyImportLastFinished": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last finished"}},"ja":{"stringUnit":{"state":"translated","value":"最終完了"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 완료"}}}},
    "token_metering.historyImportLastSync": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last import"}},"ja":{"stringUnit":{"state":"translated","value":"最終取り込み"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 가져오기"}}}},
