    "token_metering.runs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work Items"}},"ja":{"stringUnit":{"state":"translated","value":"作業項目"}},"ko":{"stringUnit":{"state":"translated","value":"작업 항목"}}}},
    "token_metering.runsInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work items are grouped from opaque folder ids, safe categories, and dates. Folder labels use short ids only; internal identifiers stay in diagnostics."}},"ja":{"stringUnit":{"state":"translated","value":"作業は不透明なフォルダ ID、安全な分類、日付でグループ化します。フォルダ表示は短い ID のみを使い、内部識別子は診断に残します。"}},"ko":{"stringUnit":{"state":"translated","value":"작업은 불투명한 폴더 ID, 안전한 분류값, 날짜 기준으로 묶습니다. 폴더 표시는 짧은 ID만 쓰고 내부 식별자는 진단 영역에 둡니다."}}}},
    "token_metering.runsInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work items"}},"ja":{"stringUnit":{"state":"translated","value":"作業項目"}},"ko":{"stringUnit":{"state":"translated","value":"작업 항목"}}}},
    "token_metering.runsSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Grouped by folder, work type, and date"}},"ja":{"stringUnit":{"state":"translated","value":"フォルダ、作業タイプ、日付ごとのグループ"}},"ko":{"stringUnit":{"state":"translated","value":"폴더, 작업 유형, 날짜별 묶음"}}}},
    "token_metering.runtimeTimingUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No timing information"}},"ja":{"stringUnit":{"state":"translated","value":"時間情報なし"}},"ko":{"stringUnit":{"state":"translated","value":"시간 정보 없음"}}}},
    "token_metering.saveTestFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not save the local test event."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルテストイベントを保存できません。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 테스트 이벤트를 저장할 수 없습니다."}}}},
    "token_metering.selectedRun": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected Work Item"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の作業"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 작업"}}}},
    "token_metering.selectedWorkItem": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected work item"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の作業"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 작업"}}}},
    "token_metering.selectedWorkItemHeader": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SELECTED WORK ITEM"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の作業"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 작업"}}}},
    "token_metering.setupApplyWhereDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Do some AI work, then open the dashboard. Login is needed only for optional web backup."}},"ja":{"stringUnit":{"state":"translated","value":"AI 作業を行ってからダッシュボードを開きます。ログインが必要なのは任意の Web バックアップだけです。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 작업을 한 뒤 대시보드를 열면 기록이 자동으로 보입니다. 로그인은 선택적 웹 백업을 쓸 때만 필요합니다."}}}},
    "token_metering.setupApplyWhereTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"3. Check the dashboard"}},"ja":{"stringUnit":{"state":"translated","value":"3. ダッシュボードで確認"}},"ko":{"stringUnit":{"state":"translated","value":"3. 대시보드 확인"}}}},
    "token_metering.setupGlobalInstructionDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste it into an AI tool that can run local commands. It installs or repairs the local connection files and setup instruction."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルコマンドを実行できる AI ツールに貼り付けます。ローカル接続ファイルとセットアップ手順をインストールまたは修復します。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 명령을 실행할 수 있는 AI 도구에 붙여넣으면 필요한 연결 파일과 설정 안내를 설치하거나 복구합니다."}}}},
    "token_metering.setupGlobalInstructionTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1. Copy setup instructions"}},"ja":{"stringUnit":{"state":"translated","value":"1. セットアップ手順をコピー"}},"ko":{"stringUnit":{"state":"translated","value":"1. 설정 안내 복사"}}}},
    "token_metering.setupQuickStartDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When AI work finishes, the tool reports token counts and the dashboard updates from local records."}},"ja":{"stringUnit":{"state":"translated","value":"AI 作業が終わると、ツールがトークン数を報告し、ダッシュボードはローカル記録から更新されます。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 작업이 끝나면 도구가 토큰 수를 알려주고, 대시보드는 로컬 기록으로 업데이트됩니다."}}}},
    "token_metering.setupQuickStartTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After setup it runs automatically"}},"ja":{"stringUnit":{"state":"translated","value":"設定後は自動で動作"}},"ko":{"stringUnit":{"state":"translated","value":"설정 후에는 자동으로 동작합니다"}}}},
    "token_metering.setupWorkflowLabelsDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Totals, input, and output work without labels. Work labels only make work-type grouping clearer."}},"ja":{"stringUnit":{"state":"translated","value":"合計、入力、出力はラベルなしでも記録されます。作業ラベルは作業タイプの分類を見やすくするだけです。"}},"ko":{"stringUnit":{"state":"translated","value":"라벨이 없어도 합계, 입력, 출력은 기록됩니다. 작업 라벨은 작업 유형 구분만 더 선명하게 합니다."}}}},
    "token_metering.setupWorkflowLabelsTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"2. Work labels are optional"}},"ja":{"stringUnit":{"state":"translated","value":"2. 作業ラベルは任意"}},"ko":{"stringUnit":{"state":"translated","value":"2. 작업 라벨은 선택"}}}},
    "token_metering.sourceBreakdown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Token Detail"}},"ja":{"stringUnit":{"state":"translated","value":"トークン詳細"}},"ko":{"stringUnit":{"state":"translated","value":"토큰 세부 내역"}}}},
    "token_metering.sourceBreakdownSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact categories when reported"}},"ja":{"stringUnit":{"state":"translated","value":"報告された正確なカテゴリのみ"}},"ko":{"stringUnit":{"state":"translated","value":"정확히 보고된 카테고리만"}}}},
    "token_metering.sourceGeneratedOutput": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI response"}},"ja":{"stringUnit":{"state":"translated","value":"AI の応答"}},"ko":{"stringUnit":{"state":"translated","value":"AI 응답"}}}},
    "token_metering.sourceHistory": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conversation history"}},"ja":{"stringUnit":{"state":"translated","value":"会話履歴"}},"ko":{"stringUnit":{"state":"translated","value":"대화 기록"}}}},
    "token_metering.sourceInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Input and output totals are the reliable baseline. This chart splits tokens only when the AI tool reports exact category counts. Unknown means exact detail was unavailable; Spill does not read prompts, files, logs, or code to guess."}},"ja":{"stringUnit":{"state":"translated","value":"入力と出力の合計が信頼できる基準です。この表示は AI ツールが項目別のトークン数を正確に報告した場合だけ分けます。不明は正確な詳細が利用できないという意味で、Spill はプロンプト、ファイル、ログ、コードを読んで推測しません。"}},"ko":{"stringUnit":{"state":"translated","value":"입력과 출력 합계가 신뢰할 수 있는 기준입니다. 이 차트는 AI 도구가 항목별 토큰 수를 정확히 보고할 때만 나눕니다. 미분류는 정확한 세부 내역을 알 수 없다는 뜻이며, Spill은 프롬프트, 파일, 로그, 코드를 읽어 추정하지 않습니다."}}}},
    "token_metering.sourceInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Token detail"}},"ja":{"stringUnit":{"state":"translated","value":"トークン詳細"}},"ko":{"stringUnit":{"state":"translated","value":"토큰 세부 내역"}}}},
    "token_metering.sourceRepoContext": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Code context"}},"ja":{"stringUnit":{"state":"translated","value":"コード参照"}},"ko":{"stringUnit":{"state":"translated","value":"코드 참고 내용"}}}},
    "token_metering.sourceSystem": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System instructions"}},"ja":{"stringUnit":{"state":"translated","value":"システム指示"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 지시문"}}}},
    "token_metering.sourceToolOutput": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tool result"}},"ja":{"stringUnit":{"state":"translated","value":"ツール結果"}},"ko":{"stringUnit":{"state":"translated","value":"도구 결과"}}}},
    "token_metering.sourceUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unclassified detail"}},"ja":{"stringUnit":{"state":"translated","value":"未分類の詳細"}},"ko":{"stringUnit":{"state":"translated","value":"세부 미분류"}}}},
