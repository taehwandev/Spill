    "token_metering.copyPrompt": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Instructions"}},"ja":{"stringUnit":{"state":"translated","value":"手順をコピー"}},"ko":{"stringUnit":{"state":"translated","value":"안내 복사"}}}},
