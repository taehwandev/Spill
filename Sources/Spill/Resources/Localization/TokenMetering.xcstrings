    "token_metering.noInputAccountingData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No input accounting data yet."}},"ja":{"stringUnit":{"state":"translated","value":"入力内訳データはまだありません"}},"ko":{"stringUnit":{"state":"translated","value":"입력 회계 데이터 없음"}}}},
    "token_metering.noAgentStatusData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No local agents detected"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルエージェントは検出されていません"}},"ko":{"stringUnit":{"state":"translated","value":"감지된 로컬 에이전트 없음"}}}},
    "token_metering.noAgentStatusDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Token records can still exist when a tool is not currently running. Refresh after opening or configuring an agent."}},"ja":{"stringUnit":{"state":"translated","value":"ツールが現在実行中でなくても、トークン記録は残ります。エージェントを開くか設定したあとに更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"도구가 지금 실행 중이 아니어도 토큰 기록은 남을 수 있습니다. 에이전트를 열거나 설정한 뒤 새로고침하세요."}}}},
    "token_metering.noLocalTokenEvents": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No local token records yet"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルトークン記録はまだありません"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 토큰 기록 없음"}}}},
    "token_metering.noLocalTokenEventsDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After setup, new AI work appears here automatically."}},"ja":{"stringUnit":{"state":"translated","value":"設定後は、新しい AI 作業がここに自動で表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 후 새 AI 작업이 자동으로 여기에 표시됩니다."}}}},
