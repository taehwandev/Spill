    "token_metering.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"LOCAL ONLY"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルのみ"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 전용"}}}},
    "token_metering.localQueue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local storage"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルキュー"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 큐"}}}},
    "token_metering.modeCloudAggregateDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Future sync can send totals, timestamps, model ids, latency, and opaque ids only."}},"ja":{"stringUnit":{"state":"translated","value":"将来の同期では合計、タイムスタンプ、モデル ID、遅延、不透明 ID のみを送信できます。"}},"ko":{"stringUnit":{"state":"translated","value":"향후 동기화는 합계, 타임스탬프, 모델 ID, 지연 시간, 불투명 ID만 보낼 수 있습니다."}}}},
    "token_metering.modeCloudAggregateState": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires login and explicit enablement"}},"ja":{"stringUnit":{"state":"translated","value":"ログインと明示的な有効化が必要"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 및 명시적 활성화 필요"}}}},
