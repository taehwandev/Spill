    "token_metering.install": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install"}},"ja":{"stringUnit":{"state":"translated","value":"インストール"}},"ko":{"stringUnit":{"state":"translated","value":"설치"}}}},
    "token_metering.installPromptDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste this into one AI agent that can run local commands. The setup installs or repairs Codex, Claude Code, and Antigravity/AGY together, then saves the global instruction."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルコマンドを実行できる AI エージェント 1 つに貼り付けてください。Codex、Claude Code、Antigravity/AGY をまとめてインストールまたは修復し、グローバル指示を保存します。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 명령을 실행할 수 있는 AI 에이전트 하나에 붙여넣으세요. 설정은 Codex, Claude Code, Antigravity/AGY를 함께 설치하거나 복구한 뒤 전역 지침을 저장합니다."}}}},
    "token_metering.installPromptTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install prompt + one-step setup"}},"ja":{"stringUnit":{"state":"translated","value":"インストールプロンプト + ワンステップ設定"}},"ko":{"stringUnit":{"state":"translated","value":"설치 프롬프트 + 원스텝 설정"}}}},
