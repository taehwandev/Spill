    "token_metering.modeCloudDetailedDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Future detail views can add work and token category labels plus numeric counts, never content."}},"ja":{"stringUnit":{"state":"translated","value":"将来の詳細画面では作業とトークン項目名、数値だけを追加でき、内容は含めません。"}},"ko":{"stringUnit":{"state":"translated","value":"향후 상세 화면은 작업과 토큰 항목 이름, 숫자만 추가할 수 있으며 콘텐츠는 절대 포함하지 않습니다."}}}},
    "token_metering.modeCloudDetailedState": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Separate token-only opt-in"}},"ja":{"stringUnit":{"state":"translated","value":"別途トークン専用 opt-in"}},"ko":{"stringUnit":{"state":"translated","value":"별도 토큰 전용 opt-in"}}}},
    "token_metering.modeCloudDetailedTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cloud detailed"}},"ja":{"stringUnit":{"state":"translated","value":"クラウド詳細"}},"ko":{"stringUnit":{"state":"translated","value":"클라우드 상세"}}}},
    "token_metering.modeLocalOnlyDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Detailed token counts and safe categories stay in this app on this computer."}},"ja":{"stringUnit":{"state":"translated","value":"詳細なトークン数と安全なカテゴリはこのコンピューター上のアプリ内に残ります。"}},"ko":{"stringUnit":{"state":"translated","value":"상세 토큰 수와 안전한 카테고리는 이 컴퓨터의 앱 안에만 남습니다."}}}},
    "token_metering.modeLocalOnlyState": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Active without login"}},"ja":{"stringUnit":{"state":"translated","value":"ログインなしで有効"}},"ko":{"stringUnit":{"state":"translated","value":"로그인 없이 활성"}}}},
