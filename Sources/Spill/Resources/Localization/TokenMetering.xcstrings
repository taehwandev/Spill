    "token_metering.localAlias": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local name"}},"ja":{"stringUnit":{"state":"translated","value":"ローカル名"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 이름"}}}},
    "token_metering.localAliasDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved only on this device; the stored token record is not changed."}},"ja":{"stringUnit":{"state":"translated","value":"このデバイスだけに保存され、保存済みのトークン記録は変わりません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에만 저장되며 저장된 토큰 기록은 바뀌지 않습니다."}}}},
    "token_metering.localAliasPlaceholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"e.g., Feature work, bug fix"}},"ja":{"stringUnit":{"state":"translated","value":"例: 機能開発、バグ修正"}},"ko":{"stringUnit":{"state":"translated","value":"예: 기능 개발, 버그 수정"}}}},
    "token_metering.localDataManagementDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes only token usage records stored on this Mac. It does not sign out, disconnect this Mac, or remove cloud backups."}},"ja":{"stringUnit":{"state":"translated","value":"この Mac に保存されたトークン使用記録だけを削除します。ログアウト、この Mac の接続解除、クラウドバックアップの削除は行いません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에 저장된 토큰 사용 기록만 삭제합니다. 로그아웃, 이 Mac 연결 해제, 클라우드 백업 삭제와는 무관합니다."}}}},
    "token_metering.localDataDeleteOptions": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete local data"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルデータ削除"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 데이터 삭제"}}}},
