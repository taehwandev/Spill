    "token_metering.noLocalTokenEventsDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This is expected until an AI tool reports exact token counts."}},"ja":{"stringUnit":{"state":"translated","value":"AI ツールが正確なトークン数を提供するまでは正常です。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구가 정확한 토큰 수를 제공하기 전까지 정상입니다."}}}},
