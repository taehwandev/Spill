    "token_metering.format.delete_token_data_message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently deletes %2$@ local records in %1$@ (%3$@ tokens). This cannot be undone."}},"ja":{"stringUnit":{"state":"translated","value":"%1$@ のローカル記録 %2$@件（%3$@トークン）を完全に削除します。この操作は元に戻せません。"}},"ko":{"stringUnit":{"state":"translated","value":"%1$@ 범위의 로컬 기록 %2$@개(%3$@ 토큰)를 영구 삭제합니다. 이 작업은 되돌릴 수 없습니다."}}}},
    "token_metering.format.events_tokens_detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ records / %@ tokens"}},"ja":{"stringUnit":{"state":"translated","value":"%@件の記録 / %@トークン"}},"ko":{"stringUnit":{"state":"translated","value":"%@개 기록 / %@ 토큰"}}}},
