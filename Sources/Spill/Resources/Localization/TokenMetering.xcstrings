    "token_metering.workflowInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work type is a reusable label supplied by the tool or workflow. If labels are missing, totals, input, output, model, and time range still remain useful."}},"ja":{"stringUnit":{"state":"translated","value":"作業タイプはツールまたは作業フローから提供される再利用可能なラベルです。ラベルがなくても、合計、入力、出力、モデル、期間は有用です。"}},"ko":{"stringUnit":{"state":"translated","value":"작업 유형은 도구나 작업 흐름이 제공한 재사용 가능한 라벨입니다. 라벨이 없어도 합계, 입력, 출력, 모델, 기간은 여전히 유용합니다."}}}},
    "token_metering.workflowInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work type"}},"ja":{"stringUnit":{"state":"translated","value":"作業タイプ"}},"ko":{"stringUnit":{"state":"translated","value":"작업 유형"}}}},
