    "token_metering.modelInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Model ids are reported by the AI tool. Spill does not infer model names from prompts, logs, files, or commands."}},"ja":{"stringUnit":{"state":"translated","value":"モデル ID は AI ツールが報告した値です。Spill はプロンプト、ログ、ファイル、コマンドからモデル名を推測しません。"}},"ko":{"stringUnit":{"state":"translated","value":"모델 ID는 AI 도구가 알려준 값입니다. Spill은 프롬프트, 로그, 파일, 명령에서 모델명을 추정하지 않습니다."}}}},
    "token_metering.modelInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Model ids"}},"ja":{"stringUnit":{"state":"translated","value":"モデル ID"}},"ko":{"stringUnit":{"state":"translated","value":"모델 ID"}}}},
