    "token_metering.stageBreakdownSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Planning, writing, checking, and similar steps"}},"ja":{"stringUnit":{"state":"translated","value":"計画、作成、確認などの作業の流れ"}},"ko":{"stringUnit":{"state":"translated","value":"계획, 작성, 확인 등 작업 흐름"}}}},
    "token_metering.stageInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Work step shows the main part of the recorded work, such as planning, writing, checking, or summarizing."}},"ja":{"stringUnit":{"state":"translated","value":"作業ステップは、記録された作業で最も大きな部分を占めた流れを表します。例: 計画、作成、確認、要約。"}},"ko":{"stringUnit":{"state":"translated","value":"작업 단계는 기록된 작업에서 가장 큰 비중을 차지한 흐름을 뜻합니다. 예: 계획, 작성, 확인, 요약."}}}},
