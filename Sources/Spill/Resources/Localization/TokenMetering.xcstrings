    "token_metering.copyWebSetup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Install Command"}},"ja":{"stringUnit":{"state":"translated","value":"インストールコマンドをコピー"}},"ko":{"stringUnit":{"state":"translated","value":"설치 명령 복사"}}}},
    "token_metering.cumulativeOnlyBadge": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Totals only"}},"ja":{"stringUnit":{"state":"translated","value":"合計のみ"}},"ko":{"stringUnit":{"state":"translated","value":"합계만"}}}},
    "token_metering.cumulativeOnlyInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This AI tool reported the total token count but not exact categories. Spill keeps the total and does not inspect content to fill in the missing detail."}},"ja":{"stringUnit":{"state":"translated","value":"この AI ツールは合計トークン数だけを報告し、項目別の数値は報告しませんでした。Spill は合計だけを保存し、足りない詳細を埋めるために内容を読みません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 AI 도구는 전체 토큰 수만 알려주고 항목별 수치는 알려주지 않았습니다. Spill은 합계만 보관하고, 빠진 세부 내역을 채우려고 내용을 읽지 않습니다."}}}},
    "token_metering.cumulativeOnlyInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only totals were recorded"}},"ja":{"stringUnit":{"state":"translated","value":"合計のみ記録"}},"ko":{"stringUnit":{"state":"translated","value":"합계만 기록됨"}}}},
    "token_metering.currentDashboardScope": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current dashboard scope"}},"ja":{"stringUnit":{"state":"translated","value":"現在のダッシュボード範囲"}},"ko":{"stringUnit":{"state":"translated","value":"현재 대시보드 범위"}}}},
    "token_metering.dashboard": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dashboard"}},"ja":{"stringUnit":{"state":"translated","value":"ダッシュボード"}},"ko":{"stringUnit":{"state":"translated","value":"대시보드"}}}},
    "token_metering.dashboardEmptyAutomaticDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After setup, Codex, Claude Code, and Antigravity/AGY add local records when AI work finishes."}},"ja":{"stringUnit":{"state":"translated","value":"設定後は、Codex、Claude Code、Antigravity/AGY の作業完了時にローカル記録が追加されます。"}},"ko":{"stringUnit":{"state":"translated","value":"설정 후에는 Codex, Claude Code, Antigravity/AGY 작업이 끝날 때 로컬 기록이 들어옵니다."}}}},
    "token_metering.dashboardEmptyAutomaticTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fills automatically"}},"ja":{"stringUnit":{"state":"translated","value":"自動で反映"}},"ko":{"stringUnit":{"state":"translated","value":"자동으로 채워짐"}}}},
    "token_metering.dashboardEmptyGuideDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spill does not run AI work. When a connected AI tool reports token counts, this dashboard fills in automatically."}},"ja":{"stringUnit":{"state":"translated","value":"Spill が AI 作業を実行するわけではありません。接続済み AI ツールがトークン数を報告すると、このダッシュボードが自動で埋まります。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill이 AI 작업을 실행하는 것은 아닙니다. 연결된 AI 도구가 토큰 수를 알려주면 이 대시보드가 자동으로 채워집니다."}}}},
    "token_metering.dashboardEmptyGuideTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No AI usage recorded yet"}},"ja":{"stringUnit":{"state":"translated","value":"AI 使用量はまだ記録されていません"}},"ko":{"stringUnit":{"state":"translated","value":"AI 사용량을 아직 기록하지 않았습니다"}}}},
    "token_metering.dashboardEmptyOpenSettings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Token Metering Settings"}},"ja":{"stringUnit":{"state":"translated","value":"トークン計測設定を開く"}},"ko":{"stringUnit":{"state":"translated","value":"토큰 미터링 설정 열기"}}}},
    "token_metering.dashboardEmptyPrivacyDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spill stores counts, tool, time, and safe work labels only."}},"ja":{"stringUnit":{"state":"translated","value":"保存するのは数値、ツール、時刻、安全な作業ラベルだけです。"}},"ko":{"stringUnit":{"state":"translated","value":"토큰 수, 도구, 시간, 안전한 작업 라벨만 저장합니다."}}}},
    "token_metering.dashboardEmptyPrivacyTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No content saved"}},"ja":{"stringUnit":{"state":"translated","value":"内容は保存しません"}},"ko":{"stringUnit":{"state":"translated","value":"내용은 저장하지 않음"}}}},
    "token_metering.dashboardEmptyPreview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Empty Preview"}},"ja":{"stringUnit":{"state":"translated","value":"空のプレビュー"}},"ko":{"stringUnit":{"state":"translated","value":"빈 상태 미리보기"}}}},
    "token_metering.dashboardEmptyPreviewDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shows the onboarding empty state without deleting local token records."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルトークン記録を削除せず、オンボーディングの空状態を表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 토큰 기록은 삭제하지 않고 온보딩 빈 상태만 보여줍니다."}}}},
    "token_metering.dashboardEmptySetupDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the setup instructions or command in Settings once to connect your AI tools."}},"ja":{"stringUnit":{"state":"translated","value":"設定でセットアップ手順またはコマンドを一度適用して AI ツールを接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"설정에서 설정 안내나 설치 명령을 한 번 적용해 AI 도구를 연결하세요."}}}},
    "token_metering.dashboardEmptySetupTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"One-time setup first"}},"ja":{"stringUnit":{"state":"translated","value":"最初に一度だけ設定"}},"ko":{"stringUnit":{"state":"translated","value":"처음에는 설정 필요"}}}},
    "token_metering.dashboardSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shows local token usage reported by connected AI tools."}},"ja":{"stringUnit":{"state":"translated","value":"接続済み AI ツールが報告したローカルトークン使用量を表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"연결된 AI 도구가 알려준 로컬 토큰 사용량을 보여줍니다."}}}},
    "token_metering.dashboardTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spill - AI Token Metering"}},"ja":{"stringUnit":{"state":"translated","value":"Spill - AI Token Metering"}},"ko":{"stringUnit":{"state":"translated","value":"Spill - AI Token Metering"}}}},
