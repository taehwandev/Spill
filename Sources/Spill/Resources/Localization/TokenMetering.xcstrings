    "token_metering.historyImportMetricNew": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"new"}},"ja":{"stringUnit":{"state":"translated","value":"新規"}},"ko":{"stringUnit":{"state":"translated","value":"신규"}}}},
    "token_metering.historyImportMetricSources": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"checked"}},"ja":{"stringUnit":{"state":"translated","value":"確認済み"}},"ko":{"stringUnit":{"state":"translated","value":"확인됨"}}}},
