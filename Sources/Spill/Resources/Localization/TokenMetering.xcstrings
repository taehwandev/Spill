    "token_metering.diagnosticsDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saves one test record locally so the dashboard can confirm storage is working."}},"ja":{"stringUnit":{"state":"translated","value":"保存先が動作していることを確認するため、テスト記録を1件ローカルに保存します。"}},"ko":{"stringUnit":{"state":"translated","value":"저장소가 동작하는지 확인하기 위해 테스트 기록 하나를 로컬에 저장합니다."}}}},
