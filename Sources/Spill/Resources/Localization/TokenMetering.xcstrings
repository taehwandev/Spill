    "token_metering.historyImportTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Step 2 · Local history import (Optional)"}},"ja":{"stringUnit":{"state":"translated","value":"ステップ 2 · ローカル履歴の取り込み (オプション)"}},"ko":{"stringUnit":{"state":"translated","value":"2단계 · 로컬 기록 가져오기 (선택 사항)"}}}},
    "token_metering.input": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Input"}},"ja":{"stringUnit":{"state":"translated","value":"入力"}},"ko":{"stringUnit":{"state":"translated","value":"입력"}}}},
    "token_metering.inputAccounting": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw Input Accounting"}},"ja":{"stringUnit":{"state":"translated","value":"生の入力内訳"}},"ko":{"stringUnit":{"state":"translated","value":"원시 입력 회계"}}}},
    "token_metering.inputAccountingCacheCreation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache write"}},"ja":{"stringUnit":{"state":"translated","value":"キャッシュ作成"}},"ko":{"stringUnit":{"state":"translated","value":"캐시 작성"}}}},
    "token_metering.inputAccountingCacheRead": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache read"}},"ja":{"stringUnit":{"state":"translated","value":"キャッシュ読み取り"}},"ko":{"stringUnit":{"state":"translated","value":"캐시 읽기"}}}},
    "token_metering.inputAccountingInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw input remains the usage baseline. Claude reports fresh input, cache writes, and cache reads separately; Codex input already includes cache reads, so unsplit Codex input stays in Unsplit input unless an exact split is reported. Workflow labels are separate from token direction. Cache discounts belong to cost analysis, not raw metering."}},"ja":{"stringUnit":{"state":"translated","value":"生の入力が使用量の基準です。Claude は新規入力、キャッシュ作成、キャッシュ読み取りを分けて報告します。Codex の入力はキャッシュ読み取りをすでに含むため、正確な内訳がない Codex 入力は「未分割の入力」に残ります。作業ラベルはトークン方向とは別です。キャッシュ割引はコスト分析で扱い、生の計測には入れません。"}},"ko":{"stringUnit":{"state":"translated","value":"원시 입력이 사용량 기준입니다. Claude는 신규 입력, 캐시 작성, 캐시 읽기를 따로 보고합니다. Codex 입력은 캐시 읽기를 이미 포함하므로, 정확한 분해가 없는 Codex 입력은 분해 안 된 입력에 남습니다. 작업 라벨은 토큰 방향과 별개입니다. 캐시 할인은 비용 분석에서 다루고 원시 미터링에는 넣지 않습니다."}}}},
    "token_metering.inputAccountingInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw usage vs cost"}},"ja":{"stringUnit":{"state":"translated","value":"生の使用量とコスト"}},"ko":{"stringUnit":{"state":"translated","value":"원시 사용량과 비용"}}}},
    "token_metering.inputAccountingSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Input split from exact runtime accounting"}},"ja":{"stringUnit":{"state":"translated","value":"ランタイムが正確に報告した入力内訳"}},"ko":{"stringUnit":{"state":"translated","value":"런타임이 정확히 보고한 입력 분해"}}}},
    "token_metering.inputAccountingUncached": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fresh input"}},"ja":{"stringUnit":{"state":"translated","value":"新規入力"}},"ko":{"stringUnit":{"state":"translated","value":"신규 입력"}}}},
    "token_metering.inputAccountingUnclassified": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unsplit input"}},"ja":{"stringUnit":{"state":"translated","value":"未分割の入力"}},"ko":{"stringUnit":{"state":"translated","value":"분해 안 된 입력"}}}},
    "token_metering.install": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install"}},"ja":{"stringUnit":{"state":"translated","value":"インストール"}},"ko":{"stringUnit":{"state":"translated","value":"설치"}}}},
    "token_metering.installPromptDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set it up once, then Codex, Claude Code, and Antigravity/AGY record token counts locally in Spill."}},"ja":{"stringUnit":{"state":"translated","value":"一度設定すると、Codex、Claude Code、Antigravity/AGY がトークン数を Spill にローカル記録します。"}},"ko":{"stringUnit":{"state":"translated","value":"한 번만 설정하면 Codex, Claude Code, Antigravity/AGY가 토큰 수를 Spill에 로컬로 기록합니다."}}}},
    "token_metering.installPromptTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Automatic token recording"}},"ja":{"stringUnit":{"state":"translated","value":"トークン使用量の自動記録"}},"ko":{"stringUnit":{"state":"translated","value":"토큰 사용량 자동 기록"}}}},
    "token_metering.installed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed"}},"ja":{"stringUnit":{"state":"translated","value":"インストール済み"}},"ko":{"stringUnit":{"state":"translated","value":"설치됨"}}}},
    "token_metering.lastUpdatedLabel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last updated"}},"ja":{"stringUnit":{"state":"translated","value":"最終更新"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 갱신"}}}},
    "token_metering.latencyUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No timing"}},"ja":{"stringUnit":{"state":"translated","value":"時間情報なし"}},"ko":{"stringUnit":{"state":"translated","value":"시간 정보 없음"}}}},
    "token_metering.localAlias": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local name"}},"ja":{"stringUnit":{"state":"translated","value":"ローカル名"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 이름"}}}},
    "token_metering.localAliasDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved only on this device; the stored token record is not changed."}},"ja":{"stringUnit":{"state":"translated","value":"このデバイスだけに保存され、保存済みのトークン記録は変わりません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에만 저장되며 저장된 토큰 기록은 바뀌지 않습니다."}}}},
    "token_metering.localAliasPlaceholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"e.g., Feature work, bug fix"}},"ja":{"stringUnit":{"state":"translated","value":"例: 機能開発、バグ修正"}},"ko":{"stringUnit":{"state":"translated","value":"예: 기능 개발, 버그 수정"}}}},
    "token_metering.localDataManagementDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes only token usage records stored on this Mac. It does not sign out, disconnect this Mac, or remove cloud backups."}},"ja":{"stringUnit":{"state":"translated","value":"この Mac に保存されたトークン使用記録だけを削除します。ログアウト、この Mac の接続解除、クラウドバックアップの削除は行いません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에 저장된 토큰 사용 기록만 삭제합니다. 로그아웃, 이 Mac 연결 해제, 클라우드 백업 삭제와는 무관합니다."}}}},
    "token_metering.localDataDeleteOptions": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete local data"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルデータ削除"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 데이터 삭제"}}}},
    "token_metering.localEventQueue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local event queue"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルイベントキュー"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 이벤트 큐"}}}},
    "token_metering.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"LOCAL ONLY"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルのみ"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 전용"}}}},
    "token_metering.webSyncEnabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Web sync on"}},"ja":{"stringUnit":{"state":"translated","value":"Web同期オン"}},"ko":{"stringUnit":{"state":"translated","value":"웹 동기화 켜짐"}}}},
    "token_metering.localQueue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local storage"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルストレージ"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 저장소"}}}},
    "token_metering.modelBreakdown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Model Breakdown"}},"ja":{"stringUnit":{"state":"translated","value":"モデル別使用量"}},"ko":{"stringUnit":{"state":"translated","value":"모델별 사용량"}}}},
    "token_metering.modelInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Model ids are reported by the AI tool. Spill does not infer model names from prompts, logs, files, or commands."}},"ja":{"stringUnit":{"state":"translated","value":"モデル ID は AI ツールが報告した値です。Spill はプロンプト、ログ、ファイル、コマンドからモデル名を推測しません。"}},"ko":{"stringUnit":{"state":"translated","value":"모델 ID는 AI 도구가 알려준 값입니다. Spill은 프롬프트, 로그, 파일, 명령에서 모델명을 추정하지 않습니다."}}}},
    "token_metering.modelInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Model ids"}},"ja":{"stringUnit":{"state":"translated","value":"モデル ID"}},"ko":{"stringUnit":{"state":"translated","value":"모델 ID"}}}},
