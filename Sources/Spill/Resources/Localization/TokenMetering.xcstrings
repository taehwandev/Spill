    "token_metering.privateUsageUploadOpenDashboardDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens the Spill web dashboard for synced usage."}},"ja":{"stringUnit":{"state":"translated","value":"同期された使用量を Spill Web ダッシュボードで開きます。"}},"ko":{"stringUnit":{"state":"translated","value":"동기화된 사용량을 Spill 웹 대시보드에서 엽니다."}}}},
