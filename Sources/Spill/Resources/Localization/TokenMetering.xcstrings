    "token_metering.promptInstructionCardDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste once. The installer stores one shared instruction in ~/.spill and connects Codex, Claude, and AGY automatically."}},"ja":{"stringUnit":{"state":"translated","value":"一度貼り付けるだけです。インストーラーが ~/.spill に共通手順を1つ保存し、Codex・Claude・AGYへ自動接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"한 번만 붙여넣으세요. 설치기가 ~/.spill에 공통 안내 하나를 저장하고 Codex·Claude·AGY를 자동으로 연결합니다."}}}},
    "token_metering.promptInstructionCardTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Setup instruction"}},"ja":{"stringUnit":{"state":"translated","value":"セットアップ手順"}},"ko":{"stringUnit":{"state":"translated","value":"설정 안내"}}}},
    "token_metering.menuBarTokenDisplayModeDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select how token counts are formatted in the menu bar."}},"ja":{"stringUnit":{"state":"translated","value":"メニューバーに表示するトークン使用量の形式を選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"메뉴 막대에 토큰 사용량을 표시할 방식을 선택합니다."}}}},
