    "token_metering.adapters": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI connections"}},"ja":{"stringUnit":{"state":"translated","value":"AI 接続"}},"ko":{"stringUnit":{"state":"translated","value":"AI 연결"}}}},
    "token_metering.agentConnectionStatus": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Agent Connection Status"}},"ja":{"stringUnit":{"state":"translated","value":"エージェント接続状態"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트 연결 상태"}}}},
    "token_metering.agentStatusDetected": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Detected"}},"ja":{"stringUnit":{"state":"translated","value":"検出済み"}},"ko":{"stringUnit":{"state":"translated","value":"감지됨"}}}},
    "token_metering.agentStatusInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shows locally detected agent tools, process count, CPU, memory, model or version hints, and local token share. Spill does not inspect prompts, transcripts, commands, file paths, logs, or code."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルで検出したエージェントツール、プロセス数、CPU、メモリ、モデルまたはバージョンのヒント、ローカルトークン比率を表示します。Spill はプロンプト、会話記録、コマンド、ファイルパス、ログ、コードを読みません。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬에서 감지한 에이전트 도구, 프로세스 수, CPU, 메모리, 모델 또는 버전 힌트, 로컬 토큰 비중을 보여줍니다. Spill은 프롬프트, 대화 기록, 명령어, 파일 경로, 로그, 코드를 읽지 않습니다."}}}},
    "token_metering.agentStatusInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What agent status shows"}},"ja":{"stringUnit":{"state":"translated","value":"エージェント状態の表示内容"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트 상태 표시 내용"}}}},
    "token_metering.agentStatusSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local process, setup, and token share by agent"}},"ja":{"stringUnit":{"state":"translated","value":"エージェント別のローカルプロセス、設定、トークン比率"}},"ko":{"stringUnit":{"state":"translated","value":"에이전트별 로컬 프로세스, 설정, 토큰 비중"}}}},
    "token_metering.aiTool": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI Tool"}},"ja":{"stringUnit":{"state":"translated","value":"AI ツール"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구"}}}},
    "token_metering.aiToolDistribution": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI Tool Usage"}},"ja":{"stringUnit":{"state":"translated","value":"AI ツール別使用量"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구별 사용량"}}}},
    "token_metering.aiToolDistributionSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ranked local usage by AI tool"}},"ja":{"stringUnit":{"state":"translated","value":"AI ツール別のローカル使用量ランキング"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구별 로컬 사용량 순위"}}}},
    "token_metering.aiToolHeader": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI TOOL"}},"ja":{"stringUnit":{"state":"translated","value":"AI ツール"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구"}}}},
    "token_metering.aiToolInfoDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This comparison shows Codex, Claude Code, and Antigravity/AGY records only. Older unknown or direct OpenAI SDK records stay saved but are hidden from this agent dashboard."}},"ja":{"stringUnit":{"state":"translated","value":"この比較は Codex、Claude Code、Antigravity/AGY の記録のみを表示します。以前の方式の不明な記録や OpenAI SDK の直接利用記録は保存されますが、このエージェントダッシュボードでは非表示です。"}},"ko":{"stringUnit":{"state":"translated","value":"이 비교는 Codex, Claude Code, Antigravity/AGY 기록만 표시합니다. 이전 방식의 알 수 없는 기록이나 OpenAI SDK 직접 사용 기록은 저장소에는 남지만 이 에이전트 대시보드에서는 숨깁니다."}}}},
    "token_metering.aiToolInfoTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Included tools"}},"ja":{"stringUnit":{"state":"translated","value":"対象ツール"}},"ko":{"stringUnit":{"state":"translated","value":"대상 도구"}}}},
    "token_metering.aiToolVisibilityDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide tools from local dashboard UI only. Token records stay saved and local collection continues."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルダッシュボードの表示だけからツールを非表示にします。トークン記録は保存されたままで、ローカル収集も続きます。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 대시보드 UI에서만 도구를 숨깁니다. 토큰 기록은 저장된 채 유지되고 로컬 수집도 계속됩니다."}}}},
    "token_metering.aiToolVisibilityHidden": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hidden from dashboards"}},"ja":{"stringUnit":{"state":"translated","value":"ダッシュボードで非表示"}},"ko":{"stringUnit":{"state":"translated","value":"대시보드에서 숨김"}}}},
    "token_metering.aiToolVisibilityState": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Display only"}},"ja":{"stringUnit":{"state":"translated","value":"表示のみ"}},"ko":{"stringUnit":{"state":"translated","value":"표시만"}}}},
    "token_metering.aiToolVisibilityTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI tool visibility"}},"ja":{"stringUnit":{"state":"translated","value":"AI ツール表示"}},"ko":{"stringUnit":{"state":"translated","value":"AI 도구 표시"}}}},
