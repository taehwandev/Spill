    "token_metering.preferencesSubtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spill stores safe token counts on this Mac. Login, cloud sync, and server transfer are not active in this app slice."}},"ja":{"stringUnit":{"state":"translated","value":"Spill はこの Mac に安全なトークン数のみを保存します。このアプリ範囲ではログイン、クラウド同期、サーバー転送は有効ではありません。"}},"ko":{"stringUnit":{"state":"translated","value":"Spill은 이 Mac에 안전한 토큰 수만 저장합니다. 이 앱 슬라이스에서는 로그인, 클라우드 동기화, 서버 전송이 활성화되지 않습니다."}}}},
    "token_metering.preferencesTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local token metering"}},"ja":{"stringUnit":{"state":"translated","value":"ローカルトークン計測"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 토큰 미터링"}}}},
