    "token_metering.historyImportReady": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"READY"}},"ja":{"stringUnit":{"state":"translated","value":"準備完了"}},"ko":{"stringUnit":{"state":"translated","value":"준비됨"}}}},
    "token_metering.historyImportRunning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"RUNNING"}},"ja":{"stringUnit":{"state":"translated","value":"実行中"}},"ko":{"stringUnit":{"state":"translated","value":"실행 중"}}}},
    "token_metering.historyImportStart": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import History"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を取り込む"}},"ko":{"stringUnit":{"state":"translated","value":"기록 가져오기"}}}},
    "token_metering.historyImportToolStart": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import"}},"ja":{"stringUnit":{"state":"translated","value":"取り込む"}},"ko":{"stringUnit":{"state":"translated","value":"가져오기"}}}},
    "token_metering.historyImportStateCancelled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelled"}},"ja":{"stringUnit":{"state":"translated","value":"キャンセル済み"}},"ko":{"stringUnit":{"state":"translated","value":"취소됨"}}}},
    "token_metering.historyImportStateDone": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Done"}},"ja":{"stringUnit":{"state":"translated","value":"完了"}},"ko":{"stringUnit":{"state":"translated","value":"완료"}}}},
    "token_metering.historyImportStateFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Failed"}},"ja":{"stringUnit":{"state":"translated","value":"失敗"}},"ko":{"stringUnit":{"state":"translated","value":"실패"}}}},
    "token_metering.historyImportStateNoSource": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No records found"}},"ja":{"stringUnit":{"state":"translated","value":"取り込める履歴なし"}},"ko":{"stringUnit":{"state":"translated","value":"가져올 기록 없음"}}}},
    "token_metering.historyImportStateScanning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scanning"}},"ja":{"stringUnit":{"state":"translated","value":"スキャン中"}},"ko":{"stringUnit":{"state":"translated","value":"스캔 중"}}}},
