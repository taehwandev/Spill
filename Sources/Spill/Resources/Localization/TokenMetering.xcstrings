    "token_metering.format.installed_at": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ -> %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ -> %@"}},"ko":{"stringUnit":{"state":"translated","value":"%@ -> %@"}}}},
