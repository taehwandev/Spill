    "token_metering.queueSelfTestFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local storage test failed."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルストレージのテストに失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 저장소 테스트에 실패했습니다."}}}},
    "token_metering.queueSelfTestSuccess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local storage accepted and saved a categorized 64-token test record."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルストレージが分類済み 64 トークンのテスト記録を保存しました。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 저장소가 분류된 64토큰 테스트 기록을 저장했습니다."}}}},
