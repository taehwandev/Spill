# Copy this file to an ignored local env file when testing signed release builds.
# Keep real certificate material and .p8 contents in GitHub Actions secrets or
# another approved secret store. Do not commit real values.

# Existing Developer ID signing contract.
MACOS_DEVELOPER_ID_CERTIFICATE_BASE64=
MACOS_DEVELOPER_ID_CERTIFICATE_PASSWORD=
MACOS_CODESIGN_IDENTITY=

# Optional Developer ID Installer signing contract for .pkg assets.
MACOS_DEVELOPER_ID_INSTALLER_CERTIFICATE_BASE64=
MACOS_DEVELOPER_ID_INSTALLER_CERTIFICATE_PASSWORD=
MACOS_INSTALLER_SIGN_IDENTITY=

# App Store Connect Team API Key notarization contract.
# APPLE_NOTARYTOOL_API_KEY is the full .p8 file content in GitHub Actions.
APPLE_NOTARYTOOL_API_KEY=
APPLE_NOTARYTOOL_API_KEY_ID=
APPLE_NOTARYTOOL_API_ISSUER=

# Optional Sentry release tracking. Keep SENTRY_AUTH_TOKEN in GitHub Actions
# secrets. SENTRY_ORG, SENTRY_PROJECT, and SPILL_SENTRY_DSN may be GitHub
# Actions secrets or repository variables in the release workflow.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SPILL_SENTRY_DSN=

# Local-only alternative for manual tests. Set this instead of
# APPLE_NOTARYTOOL_API_KEY, never together.
APPLE_NOTARYTOOL_API_KEY_PATH=
APPLE_NOTARYTOOL_TIMEOUT=45m
